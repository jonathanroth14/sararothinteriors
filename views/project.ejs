<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= project.name %> — Sara Roth Interiors</title>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --mint: #E0EDEB; --mint-light: #EDF5F3; --mint-pale: #F4F9F8;
    --gold: #B8943E; --gold-light: #CBAB56; --gold-dark: #9A7A2E; --gold-pale: #F3ECD8;
    --charcoal: #2C2E2D; --dark: #3A3D3C; --warm-gray: #7A7D7C;
    --light-gray: #C8CBCA; --white: #FFFFFF; --bg: #F7FAF9;
    --error: #C45B4A; --success: #5B8C6A;
    --shadow-sm: 0 1px 3px rgba(44,46,45,0.06);
    --shadow-md: 0 4px 14px rgba(44,46,45,0.09);
    --radius: 8px; --radius-lg: 12px;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--charcoal); min-height: 100vh; }

  .top-bar {
    background: var(--charcoal); color: var(--mint-light);
    padding: 14px 32px; display: flex; align-items: center; justify-content: space-between;
    position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 20px rgba(0,0,0,0.18);
  }
  .top-bar-left { display: flex; align-items: center; gap: 16px; }
  .back-link {
    color: var(--mint-light); text-decoration: none; font-size: 13px;
    opacity: 0.7; transition: opacity 0.2s; display: flex; align-items: center; gap: 6px;
  }
  .back-link:hover { opacity: 1; }
  .top-bar h1 {
    font-family: 'Lora', serif; font-weight: 600;
    font-size: 20px; letter-spacing: 3px; color: var(--gold-light);
  }
  .top-bar-actions { display: flex; gap: 10px; }
  .btn {
    font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 600;
    padding: 9px 20px; border-radius: var(--radius); border: none; cursor: pointer;
    transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 7px; text-decoration: none;
  }
  .btn-primary { background: var(--gold); color: white; }
  .btn-primary:hover { background: var(--gold-light); transform: translateY(-1px); box-shadow: var(--shadow-md); }
  .btn-secondary { background: rgba(255,255,255,0.1); color: var(--mint-light); border: 1px solid rgba(255,255,255,0.18); }
  .btn-secondary:hover { background: rgba(255,255,255,0.18); }
  .btn-danger-sm { background: transparent; color: var(--error); border: 1px solid rgba(196,91,74,0.3); padding: 5px 12px; font-size: 12px; border-radius: var(--radius); cursor: pointer; font-family: 'DM Sans', sans-serif; font-weight: 600; }
  .btn-danger-sm:hover { background: rgba(196,91,74,0.08); }

  .container { max-width: 1000px; margin: 0 auto; padding: 36px 24px 80px; }

  /* Project Header */
  .project-header {
    background: var(--white); border-radius: var(--radius-lg);
    border: 1px solid rgba(200,203,202,0.4); padding: 28px 32px;
    margin-bottom: 28px; box-shadow: var(--shadow-sm);
    display: flex; align-items: flex-start; gap: 20px;
  }
  .project-header-accent { width: 4px; min-height: 60px; background: var(--gold); border-radius: 2px; flex-shrink: 0; }
  .project-header-info h2 {
    font-family: 'Lora', serif; font-size: 26px;
    font-weight: 700; color: var(--dark); margin-bottom: 4px;
  }
  .project-header-info .client {
    font-size: 14px; color: var(--warm-gray); margin-bottom: 6px;
  }
  .project-header-info .desc {
    font-size: 13px; color: var(--warm-gray); line-height: 1.5; margin-top: 8px;
  }

  /* Section Header */
  .section-header {
    display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px;
  }
  .section-header h3 {
    font-family: 'Lora', serif; font-size: 20px; font-weight: 700; color: var(--dark);
  }

  /* New WO Form */
  .new-wo-card {
    background: var(--white); border-radius: var(--radius-lg);
    border: 1.5px dashed var(--light-gray); padding: 24px;
    margin-bottom: 24px; transition: border-color 0.2s;
  }
  .new-wo-card:hover { border-color: var(--gold); }
  .new-wo-card h3 {
    font-family: 'Lora', serif; font-size: 16px;
    font-weight: 700; color: var(--dark); margin-bottom: 14px;
  }
  .new-wo-row { display: flex; gap: 12px; align-items: flex-end; }
  .new-wo-row .form-group { flex: 1; }
  label {
    display: block; font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 1px; color: var(--gold-dark); margin-bottom: 6px;
  }
  input[type="text"] {
    width: 100%; padding: 10px 14px; border: 1.5px solid var(--mint);
    border-radius: var(--radius); font-family: 'DM Sans', sans-serif;
    font-size: 14px; color: var(--charcoal); background: var(--white);
    outline: none; transition: border-color 0.2s, box-shadow 0.2s;
  }
  input:focus { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(184,148,62,0.12); }

  /* Work Order Cards */
  .wo-list { display: flex; flex-direction: column; gap: 14px; }
  .wo-card {
    background: var(--white); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm); border: 1px solid rgba(200,203,202,0.4);
    padding: 20px 24px; display: flex; align-items: center;
    gap: 16px; transition: all 0.2s; cursor: pointer;
    text-decoration: none; color: inherit; position: relative; overflow: hidden;
  }
  .wo-card:hover { box-shadow: var(--shadow-md); border-color: var(--gold); transform: translateX(3px); }
  .wo-card-icon {
    width: 42px; height: 42px; background: var(--gold-pale);
    border-radius: var(--radius); display: flex; align-items: center;
    justify-content: center; font-size: 18px; flex-shrink: 0;
  }
  .wo-card-info { flex: 1; }
  .wo-card-title {
    font-family: 'Lora', serif; font-size: 17px;
    font-weight: 700; color: var(--dark); margin-bottom: 4px;
  }
  .wo-card-meta { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .meta-badge {
    font-size: 11px; font-weight: 600; padding: 2px 9px;
    border-radius: 20px; background: var(--mint-pale); color: var(--warm-gray);
  }
  .meta-badge.gold { background: var(--gold-pale); color: var(--gold-dark); }
  .meta-date { font-size: 11px; color: var(--light-gray); }
  .wo-card-arrow { font-size: 18px; color: var(--light-gray); transition: color 0.2s; }
  .wo-card:hover .wo-card-arrow { color: var(--gold); }
  .wo-card-actions { display: flex; align-items: center; gap: 8px; }

  .empty-state { text-align: center; padding: 50px 24px; color: var(--warm-gray); }
  .empty-state h3 { font-family: 'Lora', serif; font-size: 20px; color: var(--dark); margin-bottom: 8px; }

  .flash-success {
    background: rgba(91,140,106,0.1); border: 1px solid rgba(91,140,106,0.3);
    color: var(--success); padding: 12px 18px; border-radius: var(--radius);
    font-size: 13px; font-weight: 500; margin-bottom: 20px;
  }
</style>
</head>
<body>

<div class="top-bar">
  <div class="top-bar-left">
    <a href="/projects" class="back-link">&#8592; All Projects</a>
    <h1>SARA ROTH INTERIORS</h1>
  </div>
  <div class="top-bar-actions">
    <a href="/logout" class="btn btn-secondary">Sign Out</a>
  </div>
</div>

<div class="container">
  <% if (flash) { %><div class="flash-success"><%= flash %></div><% } %>

  <!-- Project Info -->
  <div class="project-header">
    <div class="project-header-accent"></div>
    <div class="project-header-info">
      <h2><%= project.name %></h2>
      <div class="client"><%= project.client_name || 'No client name' %></div>
      <% if (project.description) { %>
        <div class="desc"><%= project.description %></div>
      <% } %>
    </div>
  </div>

  <!-- Work Orders -->
  <div class="section-header">
    <h3>Work Orders (<%= workOrders.length %>)</h3>
  </div>

  <!-- New Work Order Form -->
  <div class="new-wo-card">
    <h3>+ New Work Order</h3>
    <form method="POST" action="/projects/<%= project.id %>/work-orders">
      <div class="new-wo-row">
        <div class="form-group">
          <label for="title">Work Order Title</label>
          <input type="text" id="title" name="title" placeholder="e.g. Living Room Window Treatments">
        </div>
        <button type="submit" class="btn btn-primary" style="white-space:nowrap;">Create Work Order</button>
      </div>
    </form>
  </div>

  <!-- WO List -->
  <div class="wo-list">
    <% if (workOrders.length === 0) { %>
      <div class="empty-state">
        <h3>No work orders yet</h3>
        <p>Create your first work order above.</p>
      </div>
    <% } %>
    <% workOrders.forEach(wo => { %>
      <div class="wo-card" onclick="window.location='/projects/<%= project.id %>/work-orders/<%= wo.id %>'">
        <div class="wo-card-icon">📋</div>
        <div class="wo-card-info">
          <div class="wo-card-title"><%= wo.title %></div>
          <div class="wo-card-meta">
            <span class="meta-badge gold"><%= wo.version_count %> version<%= wo.version_count != 1 ? 's' : '' %></span>
            <% if (wo.last_saved) { %>
              <span class="meta-date">Last saved <%= new Date(wo.last_saved).toLocaleDateString('en-US', {month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></span>
            <% } else { %>
              <span class="meta-date">Never saved</span>
            <% } %>
          </div>
        </div>
        <div class="wo-card-actions" onclick="event.stopPropagation()">
          <form method="POST" action="/projects/<%= project.id %>/work-orders/<%= wo.id %>/delete" onsubmit="return confirm('Delete this work order and all its history?')">
            <button type="submit" class="btn-danger-sm">Delete</button>
          </form>
        </div>
        <div class="wo-card-arrow">›</div>
      </div>
    <% }) %>
  </div>
</div>

</body>
</html>
